{
  "name": "testvelixo-custom-functions",
  "version": "1.0.0",
  "description": "Excel add-in: FACTORIALROW custom function (TESTVELIXO namespace)",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "dependencies": {
    "core-js": "^3.37.0"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "copy-webpack-plugin": "^12.0.2",
    "custom-functions-metadata-plugin": "^1.3.1",
    "office-addin-debugging": "^5.1.6",
    "office-addin-dev-certs": "^1.13.0",
    "office-addin-manifest": "^1.13.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  }
}
